                        <!-- Group rooms by categories - simplified approach -->
                        {% set all_room_data = [] %}
                        {% set bedroom_count = 0 %}
                        {% set bathroom_count = 0 %}
                        {% set closet_count = 0 %}
                        
                        <!-- Create category mapping lookup - only for rooms that should be grouped -->
                        {% set space_type_categories = {
                            'Pool Area': 'outdoor_space',
                            'Porch': 'outdoor_space',
                            'Patio': 'outdoor_space',
                            'Attached Garage': 'outdoor_space',
                            'Garage': 'outdoor_space',
                            'Carport': 'outdoor_space',
                            'Porches': 'outdoor_space'
                        } %}
                        
                        <!-- Collect all rooms with their categories -->
                        {% for room_collection in all_room_collections %}
                            {% for room in room_collection %}
                                {% if room.space_type %}
                                    {% set room_properties = [] %}
                                    {% for key, value in room %}
                                        {% if key != 'space_type' and key != 'floor_level' and value and value.enumDescription %}
                                            {% set room_properties = (room_properties.push(value), room_properties) %}
                        {% endif %}
                                    {% endfor %}
                                    
                                    <!-- Get category from mapping lookup (undefined if not mapped) -->
                                    {% set room_category = space_type_categories[room.space_type.enumDescription] %}
                                    {% set room_type_lower = room.space_type.enumDescription | lower %}
                                    
                                    <!-- Include room if: it has properties OR it has a category mapping OR it's a bedroom/bathroom -->
                                    {% if room_properties | length > 0 or room_category or 'bedroom' in room_type_lower or 'bathroom' in room_type_lower %}
                                        <!-- Create room title with numbering -->
                                        {% set room_type = room.space_type.enumDescription %}
                                        
                                        {% if 'bedroom' in room_type_lower %}
                                            {% set bedroom_count = bedroom_count + 1 %}
                                            {% set room_title = room_type + ' ' + bedroom_count | string %}
                                        {% elif 'bathroom' in room_type_lower %}
                                            {% set bathroom_count = bathroom_count + 1 %}
                                            {% set room_title = room_type + ' ' + bathroom_count | string %}
                                        {% elif 'closet' in room_type_lower %}
                                            {% set closet_count = closet_count + 1 %}
                                            {% set room_title = room_type + ' ' + closet_count | string %}
                                        {% else %}
                                            {% set room_title = room_type %}
                                      {% endif %}
                                        
                                        <!-- Create room data object -->
                                        {% set room_data = {
                                            'title': room_title,
                                            'category': room_category,
                                            'icon': room.space_type.iconName,
                                            'room': room
                                        } %}
                                        {% set all_room_data = (all_room_data.push(room_data), all_room_data) %}
                                    {% endif %}
                                {% endif %}
                            {% endfor %}
                        {% endfor %}
                        
                        <!-- Dynamic Room Categorization: Rooms with properties get own sections, rooms without properties group by category -->
                        
                        <!-- First, separate rooms into those with properties and those without -->
                        {% set rooms_with_properties = [] %}
                        {% set rooms_without_properties = [] %}
                        {% for room_data in all_room_data %}
                            {% set has_properties = false %}
                            {% for key, value in room_data.room %}
                                {% if key != 'space_type' and key != 'floor_level' and value and value.enumDescription %}
                                    {% set has_properties = true %}
                                {% endif %}
                            {% endfor %}
                            
                            <!-- Check if it's a bedroom or bathroom -->
                            {% set is_bedroom_or_bathroom = 'bedroom' in (room_data.title | lower) or 'bathroom' in (room_data.title | lower) %}
                            
                            {% if has_properties or is_bedroom_or_bathroom %}
                                {% set rooms_with_properties = (rooms_with_properties.push(room_data), rooms_with_properties) %}
                            {% else %}
                                {% set rooms_without_properties = (rooms_without_properties.push(room_data), rooms_without_properties) %}
                            {% endif %}
                        {% endfor %}
                        
                        <!-- Display rooms with properties as individual sections -->
                        {% for room_data in rooms_with_properties %}
                        {% set display_title = room_data.title %}
                        {% set outer_index = loop.index0 %}
                        {% set total_count = 0 %}
                        {% for i in rooms_with_properties %}
                            {% if i.title == room_data.title %}
                                {% set total_count = total_count + 1 %}
                            {% endif %}
                        {% endfor %}
                        {% if total_count > 1 %}
                            {% set current_index = 1 %}
                            {% for i in rooms_with_properties %}
                                {% if i.title == room_data.title %}
                                    {% if loop.index0 == outer_index %}
                                        {% set display_title = room_data.title + ' ' + current_index %}
                                    {% endif %}
                                    {% if loop.index0 < outer_index %}
                                        {% set current_index = current_index + 1 %}
                                    {% endif %}
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                            <div class="modal-category">
                                <h3 class="modal-category-title">{{ display_title }}</h3>
                                <div class="modal-features-grid">
                                    <!-- Room properties -->
                                    {% for key, value in room_data.room %}
                                        {% if key != 'space_type' and key != 'floor_level' and value and value.enumDescription %}
                                        <div class="modal-feature-item">
                                            <div class="modal-feature-row">
                                                {% if value.iconName %}
                                                    {{ renderSvg(value.iconName, value.enumDescription, '') }}
                                                {% endif %}
                                                <span class="modal-feature-text">{{ value.enumDescription }}</span>
                                      </div>
                                    </div>
                                        {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                        {% endfor %}
                        
                        <!-- Display rooms without properties grouped by category -->
                        {% set categories_processed = [] %}
                        {% for room_data in rooms_without_properties %}
                            {% if room_data.category and room_data.category not in categories_processed %}
                                {% set categories_processed = (categories_processed.push(room_data.category), categories_processed) %}
                                {% set category_rooms = rooms_without_properties | selectattr('category', 'equalto', room_data.category) | list %}
                                
                                <!-- Determine category title -->
                                {% set category_title = room_data.category | title | replace('_', ' ') %}
                                {% if room_data.category == 'outdoor_space' %}
                                    {% set category_title = 'Outdoor Spaces' %}
                                {% elif room_data.category == 'exterior_feature' %}
                                    {% set category_title = 'Exterior Features' %}
                        {% endif %}

                                <div class="modal-category">
                                    <h3 class="modal-category-title">{{ category_title }}</h3>
                                    <div class="modal-features-grid">
                                        {% for category_room in category_rooms %}
                                        {% set display_title = category_room.title %}
                                        {% set outer_index = loop.index0 %}
                                        {% set total_count = 0 %}
                                        {% for i in category_rooms %}
                                            {% if i.title == category_room.title %}
                                                {% set total_count = total_count + 1 %}
                                            {% endif %}
                                        {% endfor %}
                                        {% if total_count > 1 %}
                                            {% set current_index = 1 %}
                                            {% for i in category_rooms %}
                                                {% if i.title == category_room.title %}
                                                    {% if loop.index0 == outer_index %}
                                                        {% set display_title = category_room.title + ' ' + current_index %}
                                                    {% endif %}
                                                    {% if loop.index0 < outer_index %}
                                                        {% set current_index = current_index + 1 %}
                                                    {% endif %}
                                                {% endif %}
                                            {% endfor %}
                                        {% endif %}
                                        <div class="modal-feature-item">
                                            <div class="modal-feature-row">
                                                {% if category_room.icon %}
                                                    {{ renderSvg(category_room.icon, category_room.title, '') }}
                                      {% endif %}
                                                <span class="modal-feature-text">{{ display_title }}</span>
                                    </div>
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                        {% endif %}
                        {% endfor %}
                    </div>
                </div>
        </div>

        <!-- Sidebar -->
        <div class="sidebar">
            <div class="sidebar-content">
                <!-- Rental Price Card -->
                <div class="price-card">
                    <div class="price-header">
                        <div class="price-icon">
                            <span class="dollar-sign">$</span>
                        </div>
                        <span class="price-label">Last Sale Price</span>
                    </div>
                    <div class="price-amount">${{ sales_history[0].amount | number }}</div>

                    <!-- Expanded Content (Always Visible) -->
                    <div class="expanded-content">
                        <div class="tax-assessment-section">
                            <div class="expanded-content-label">Tax Assessment</div>
                            <div class="tax-assessment-amount">${{ homes[property_id].tax.property_assessed_value_amount | number }}</div>
                        </div>
                        {#
                        <div class="estimated-costs-section">
                            <div class="costs-header">Estimated Costs</div>
                            <div class="cost-item">
                                <div class="cost-label">Est. Taxes</div>
                                <div class="cost-amount">${{ homes[property_id].property.estimated_taxes | number }}</div>
                            </div>
                            <div class="cost-item">
                                <div class="cost-label">HOA Dues</div>
                                <div class="cost-amount">${{ homes[property_id].property.hoa_dues | number }}/mo</div>
                            </div>
                        </div>
                        #}
                    </div>

                    <button class="less-info-btn" onclick="toggleMoreInfo()">
                        <span>Less Info</span>
                        {{ renderSvg('uiicons-1.svg', 'Dropdown', 'dropdown-arrow rotated') }}
                    </button>
                </div>

            </div>
        </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
{% if config.inlineJs %}
<!-- JS is inlined -->
{% else %}
<script src="{{ 'js/property.js' | assetUrl }}"></script>
{% endif %}
<script>
  document.addEventListener('DOMContentLoaded',()=>{
    if(location.hash){
      const el=document.querySelector(location.hash);
      if(el){
        el.focus();
      }
    }
    
    // Auto-hide navigation when main-content doesn't exceed viewport
    checkNavigationVisibility();
  });

  // Check if navigation should be hidden based on main-content height
  function checkNavigationVisibility() {
    const navigation = document.querySelector('.navigation');
    const mainContent = document.querySelector('.main-content');
    
    if (!mainContent) return;
    
    const mainContentHeight = mainContent.offsetHeight;
    const viewportHeight = window.innerHeight;
    
    if (mainContentHeight <= viewportHeight) {
      // Main content fits in viewport, hide navigation
      navigation.classList.add('auto-hide');
    } else {
      // Main content exceeds viewport, show navigation
      navigation.classList.remove('auto-hide');
    }
  }
  
  // Recheck on window resize
  window.addEventListener('resize', checkNavigationVisibility);

  function toggleRoomDetails(header) {
    const roomItem = header.parentElement;
    const properties = roomItem.querySelector('.room-properties');
    const expandIcon = header.querySelector('.room-expand-icon');
    
    // Check if this room is currently open
    const isCurrentlyOpen = properties.style.display === 'flex' || properties.style.display === 'block';
    
    // Close all room dropdowns first
    const allRoomProperties = document.querySelectorAll('.room-properties');
    const allExpandIcons = document.querySelectorAll('.room-expand-icon');
    
    allRoomProperties.forEach(roomProps => {
      roomProps.style.display = 'none';
    });
    
    allExpandIcons.forEach(icon => {
      icon.style.transform = 'rotate(0deg)';
    });
    
    // If the clicked room was closed, open it
    if (!isCurrentlyOpen) {
      properties.style.display = 'flex';
      expandIcon.style.transform = 'rotate(180deg)';
    }
  }

  function getCurrentSlide(propertyId) {
    const radioButtons = document.querySelectorAll(`input[name="carousel-radio-${propertyId}"]`);
    for (let i = 0; i < radioButtons.length; i++) {
      if (radioButtons[i].checked) {
        return i;
      }
    }
    return 0;
  }

  function setSlide(propertyId, index) {
    const radioButtons = document.querySelectorAll(`input[name="carousel-radio-${propertyId}"]`);
    if (radioButtons[index]) {
      radioButtons[index].checked = true;
    }
  }

  function nextSlide(propertyId) {
    const radioButtons = document.querySelectorAll(`input[name="carousel-radio-${propertyId}"]`);
    const currentIndex = getCurrentSlide(propertyId);
    const nextIndex = (currentIndex + 1) % radioButtons.length;
    setSlide(propertyId, nextIndex);
  }

  function previousSlide(propertyId) {
    const radioButtons = document.querySelectorAll(`input[name="carousel-radio-${propertyId}"]`);
    const currentIndex = getCurrentSlide(propertyId);
    const prevIndex = currentIndex === 0 ? radioButtons.length - 1 : currentIndex - 1;
    setSlide(propertyId, prevIndex);
  }

  // Handle building details grid gap when second column is empty
  function handleBuildingDetailsGap() {
    const buildingDetailsGrids = document.querySelectorAll('.building-details-grid');
    
    buildingDetailsGrids.forEach(grid => {
      const secondColumn = grid.querySelector('.building-details-column:nth-child(2)');
      if (secondColumn) {
        const hasItems = secondColumn.querySelector('.building-spec-item');
        if (!hasItems) {
          grid.classList.add('single-column');
        }
      }
    });
  }

  // Run on page load
  document.addEventListener('DOMContentLoaded', handleBuildingDetailsGap);

  // Features Modal Functions
  function openFeaturesModal() {
    const modal = document.getElementById('featuresModal');
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeFeaturesModal() {
    const modal = document.getElementById('featuresModal');
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }

  // Close modal when clicking outside of it
  window.onclick = function(event) {
    const modal = document.getElementById('featuresModal');
    if (event.target === modal) {
      closeFeaturesModal();
    }
  }
</script>
{% endset %}
