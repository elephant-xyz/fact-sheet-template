{% extends "base.njk" %}

{# Macro for rendering SVG icons that can be either inlined or external #}
{% macro renderSvg(filename, altText, className="") %}
    {% if config.inlineSvg and (filename | isSvg) and not ('elephant_logo' in filename) and not ('favicon' in filename) %}
        <span class="{{ className }}" aria-label="{{ altText }}">{{ filename | assetUrl | safe }}</span>
    {% else %}
        <img src="{{ filename | assetUrl }}" alt="{{ altText }}" {% if className %}class="{{ className }}"{% endif %}>
    {% endif %}
{% endmacro %}

{# Macro for source links #}
{% macro sourceLink(sourceData, sourceTitle="County Data") %}
  {% if sourceData and sourceData.source_http_request %}
    {% set sourceUrl = sourceData.source_http_request.url %}
    {% if sourceData.source_http_request.multiValueQueryString %}
      {% set url = sourceUrl + "?" %}
      {% for key, values in sourceData.source_http_request.multiValueQueryString %}
        {% for value in values %}
          {% set url = url + key + "=" + value %}
          {% if not loop.last %}{% set url = url + "&" %}{% endif %}
        {% endfor %}
        {% if not loop.last %}{% set url = url + "&" %}{% endif %}
      {% endfor %}
    {% else %}
      {% set url = sourceUrl %}
    {% endif %}
    <div class="source-link">
      Source:&nbsp;&nbsp;<a href="{{ url }}" target="_blank" rel="noopener noreferrer" class="source-link-text">{{ sourceTitle }}</a>
    </div>
  {% endif %}
{% endmacro %}

{% set title -%}
{%- set display_property_type = homes[property_id].building.property_type or homes[property_id].property.property_type or 'Property' -%}
{%- set street_addr = homes[property_id].address.street_address or homes[property_id].unormalized_address.street_address -%}
{%- set city = homes[property_id].address.city_name or homes[property_id].unormalized_address.city_name or '' -%}
{%- set state = homes[property_id].address.state_code or homes[property_id].unormalized_address.state_code or '' -%}
{%- set postal = homes[property_id].address.postal_code or homes[property_id].unormalized_address.postal_code or '' -%}
{%- if street_addr -%}
  {{- street_addr | titleCase }}, {{ city | titleCase }}, {{ state }} {{ postal -}}
{%- else -%}
  {{- display_property_type }} in {{ city | titleCase }}, {{ state -}}
{%- endif -%}
{%- endset %}

{% set description -%}
{%- set street_addr = homes[property_id].address.street_address or homes[property_id].unormalized_address.street_address -%}
{%- set city = homes[property_id].address.city_name or homes[property_id].unormalized_address.city_name or '' -%}
{%- set state = homes[property_id].address.state_code or homes[property_id].unormalized_address.state_code or '' -%}
{%- set postal = homes[property_id].address.postal_code or homes[property_id].unormalized_address.postal_code or '' -%}
{%- set beds = homes[property_id].building.bedrooms -%}
{%- set baths = homes[property_id].building.bathrooms -%}
{%- set sqft = homes[property_id].building.total_sqft or homes[property_id].building.living_sqft -%}
{%- if beds and beds > 0 and baths -%}
  {{- beds }}-bed, {{ baths }}-bath {{ display_property_type | lower }} in {{ city | titleCase -}}
  {%- if sqft %}, {{ sqft }} sqft{% endif -%}
  {%- if street_addr %}, {{ street_addr | titleCase }}, {{ state }} {{ postal }}{% endif -%}
{%- else -%}
  {{- display_property_type }} in {% if homes[property_id].address.county_name %}{{ homes[property_id].address.county_name }} County{% elif homes[property_id].unormalized_address.county_jurisdiction %}{{ homes[property_id].unormalized_address.county_jurisdiction }}{% else %}{{ city | titleCase }}, {{ state }}{% endif -%}
  {%- if street_addr %}, {{ street_addr | titleCase }}, {{ state }} {{ postal }}{% endif -%}
{%- endif -%}
{%- endset %}

{% set og_url -%}{{ config.domain }}/homes/{{ property_id }}{%- endset %}
{% set twitter_url -%}{{ config.domain }}/homes/{{ property_id }}{%- endset %}

{% set og_title -%}{{ title }}{%- endset %}
{% set og_description -%}{{ description }}{%- endset %}
{% set og_image -%}https://elephant.xyz/images/elephant_favicon-dark.svg{%- endset %}
{% set twitter_title -%}{{ title }}{%- endset %}
{% set twitter_description -%}{{ description }}{%- endset %}
{% set twitter_image -%}https://elephant.xyz/images/elephant_favicon-dark.svg{%- endset %}

{% set content %}

<script>
// Section visibility configuration from backend
const sectionVisibility = {{ homes[property_id].sectionVisibility | json | safe }};

// Function to show/hide sections based on label
function updateSectionVisibility(label) {
  console.log('Updating section visibility for label:', label);
  
  if (!sectionVisibility || !sectionVisibility.label_to_div_mapping) {
    console.log('No section visibility configuration found');
    return;
  }
  
  const sections = sectionVisibility.label_to_div_mapping[label];
  if (!sections) {
    console.log('No sections found for label:', label);
    return;
  }
  
  console.log('Sections to show:', sections);
  
  // Hide all sections first
  document.querySelectorAll('[data-section]').forEach(section => {
    console.log('Hiding section:', section.id);
    section.classList.remove('show');
  });
  
  // Show only the sections for this label
  sections.forEach(sectionName => {
    const section = document.querySelector(`[data-section="${sectionName}"]`);
    if (section) {
      console.log('Showing section:', sectionName, 'element:', section);
      section.classList.add('show');
    } else {
      console.log('Section not found:', sectionName);
      // Debug: list all data-section elements
      const allSections = document.querySelectorAll('[data-section]');
      console.log('All data-section elements:', allSections);
    }
  });
}

         // Initialize with the label determined from the data
         document.addEventListener('DOMContentLoaded', function() {
           updateSectionVisibility('{{ homes[property_id].dataLabel or "Seed" }}');
         });
</script>

