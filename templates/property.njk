                    <!-- 2nd Floor -->
                    {% if second_floor_rooms | length > 0 and second_floor_rooms | selectattr('space_type') | list | length > 0 %}
                    <div class="floor-section">
                        <div class="floor-header">
                            {{ renderSvg('featuresicons-5.svg', '2nd Floor', 'floor-header-icon') }}
                            <h3 class="h5-style">2nd Floor</h3>
                        </div>
                        {{ floorRooms(second_floor_rooms) }}
                    </div>
                    {% endif %}
                    
                    <!-- Other Floors -->
                    {% if other_rooms | length > 0 and other_rooms | selectattr('space_type') | list | length > 0 %}
                    <div class="floor-section">
                        <div class="floor-header">
                            {{ renderSvg('featuresicons-33.svg', 'Other Floors', 'floor-header-icon') }}
                            <h3 class="h5-style">Other Floors</h3>
                        </div>
                        {{ floorRooms(other_rooms) }}
                    </div>
                    {% endif %}
                  </div>
                  
                  <!-- Source Link -->
                  {% if homes[property_id].layouts and homes[property_id].layouts.source_http_request and homes[property_id].layouts.source_http_request.url %}
                    {{ sourceLink(homes[property_id].layouts, "County Appraiser") }}
                  {% elif homes[property_id].property and homes[property_id].property.source_http_request and homes[property_id].property.source_http_request.url %}
                    {{ sourceLink(homes[property_id].property, "County Appraiser") }}
                  {% endif %}
                </section>
                {% else %}
                <!-- Show all rooms in one section when no floor level data is present -->
                {% set all_rooms = [] %}
                {% if first_floor_rooms %}
                    {% set all_rooms = all_rooms + first_floor_rooms %}
                {% endif %}
                {% if second_floor_rooms %}
                    {% set all_rooms = all_rooms + second_floor_rooms %}
                {% endif %}
                {% if other_rooms %}
                    {% set all_rooms = all_rooms + other_rooms %}
                {% endif %}
                
                {% if all_rooms | length > 0 %}
                <section id="floorplan-layout" class="section scroll-offset-section show floorplan-layout" data-section="floorplan-layout">
                  <div class="floorplan-floors">
                    <div class="floor-section">
                        <div class="floor-header">
                            {{ renderSvg('featuresicons-13.svg', 'Property Layout', 'floor-header-icon') }}
                            <h3 class="h5-style">Property Layout</h3>
                        </div>
                        {{ floorRooms(all_rooms) }}
                    </div>
                  </div>
                  
                  <!-- Source Link -->
                  {% if homes[property_id].layouts and homes[property_id].layouts.source_http_request and homes[property_id].layouts.source_http_request.url %}
                    {{ sourceLink(homes[property_id].layouts, "County Appraiser") }}
                  {% elif homes[property_id].property and homes[property_id].property.source_http_request and homes[property_id].property.source_http_request.url %}
                    {{ sourceLink(homes[property_id].property, "County Appraiser") }}
                  {% endif %}
                </section>
                {% endif %}
                {% endif %}
            {% endif %}
            

            
            <!-- Utility Systems -->
            <!-- Property Features -->
            {% set interior_features = homes[property_id].features.interior %}
            {% set exterior_features = homes[property_id].features.exterior %}
            {% set utilities = homes[property_id].utility %}
            {% set appliances = homes[property_id].appliances %}

            {% macro renderFeature(features) %}
              <div class="features-list">
                  {% for feature in features %}
                  <div class="feature-item-detailed">
                      <div class="feature-row">
                        {% set iconPath = feature.iconName %}
                        {% if iconPath %}
                          {{ renderSvg(iconPath, feature.info.description, '') }}
                        {% endif %}
                        <div class="feature-text-content">
                            <div class="feature-main-text">{{ feature.enumDescription }}</div>
                        </div>
                      </div>
                  </div>
                  {% endfor %}
              </div>
            {% endmacro %}
            
            {% if interior_features | length > 0 or exterior_features | length > 0 or utilities is defined %}
            <section id="features" class="section scroll-offset-section" data-section="features">
                <div class="features-grid">
                        <!-- Interior Features -->
                        {% if interior_features | length > 0 %}
                        <div class="features-section">
                            <h3 class="section-subtitle">Interior</h3>
                            {{ renderFeature(interior_features) }}
                        </div>
                        {% endif %}

                        <!-- Exterior Features -->
                        {% if exterior_features | length > 0  %}
                        <div class="features-section">
                            <h3 class="section-subtitle">Exterior</h3>
                            {{ renderFeature(exterior_features) }}
                        </div>
                        {% endif %}

                        <!-- Utility Systems -->
                        {% if utilities is defined %}
                        <div class="features-section">
                            <h3 class="section-subtitle">Utility Systems</h3>
                            <div class="features-list">
                                {% for key, util in utilities %}
                                <div class="feature-item-detailed">
                                    <div class="feature-row">
                                      {% set iconPath = util.iconName %}
                                      {% if iconPath %}
                                        {{ renderSvg(iconPath, util.enumDescription, '') }}
                                      {% endif %}
                                      <div class="feature-text-content">
                                          <div class="feature-main-text">{{ util.enumDescription }}</div>
                                      </div>
                                    </div>
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                        {% endif %}

                        <!-- Appliances -->
                        {% if appliances and appliances | length > 0 %}
                        <div class="features-section">
                          <h3 class="section-subtitle">Appliances</h3>
                            <div class="features-list">
                                {% for appliance in appliances  %}
                                <div class="feature-item-detailed">
                                    <div class="feature-row">
                                      {% set iconPath = appliance.appliance_type.iconName %}
                                      {% if iconPath %}
                                        {{ renderSvg(iconPath, appliance.appliance_type.enumDescription, '') }}
                                      {% endif %}
                                      <div class="feature-text-content">
                                          <div class="feature-main-text">{%if appliance.finish %}{{ appliance.finish.enumDescription }}{% endif %} {{ appliance.appliance_type.enumDescription }}</div>
                                      </div>
                                    </div>
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                        {% endif %}
                </div>
                                 {% if homes[property_id].structure and homes[property_id].structure.source_http_request and homes[property_id].structure.source_http_request.url %}
                   {{ sourceLink(homes[property_id].structure, "County Appraiser") }}
                 {% elif homes[property_id].property and homes[property_id].property.source_http_request and homes[property_id].property.source_http_request.url %}
                   {{ sourceLink(homes[property_id].property, "County Appraiser") }}
                 {% endif %}
            </section>
            {% endif %}

